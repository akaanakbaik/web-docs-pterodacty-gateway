{
  "name": "web-docs-pterodactyl-gateway",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Official documentation website for Akadev Pterodactyl Gateway SDK v1.6.0 with local search and AI assistant.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty",
    "typecheck:api": "tsc -p tsconfig.api.json --pretty",
    "test:source": "node scripts/source-guard.mjs",
    "test:ai": "tsx --test scripts/ai-failover.test.mjs",
    "test:site": "node scripts/site-smoke.mjs",
    "check": "npm run typecheck && npm run typecheck:api && npm run test:source && npm run test:ai",
    "ci": "npm run check && npm run build && npm run test:site && npm audit --audit-level=high",
    "lint": "npm run check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
